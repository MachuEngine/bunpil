# 분필 Caddy 리버스 프록시
# your-domain.com → EC2 내부 Next.js(3000) 포트로 전달
# TLS: Let's Encrypt 자동 발급 (도메인 DNS가 이 서버 IP를 가리켜야 함)
#
# frontend(Next.js, 3000)만 프록시하면 됨 — /api/* 라우트(exam, exam/stream)는
# frontend/app/api/*/route.ts가 컨테이너 내부에서 BACKEND_URL(=http://app:8765)로
# 다시 프록시하므로, Caddy가 FastAPI(8765)를 직접 볼 필요 없음.
# (record 라우트는 생기부 모듈과 함께 2026-08-03 제거됨)
# docker-compose.yml의 frontend 서비스가 3000:3000으로 호스트에 포트를 열어둠.

your-domain.com {
	# 2026-08-19: 이미지 업로드(/api/exam/extract)만 5MB까지 허용 — 스크린샷은
	# 보통 300KB~2MB. 텍스트 경로(아래 기본 handle, 64KB)는 그대로 둔다.
	# app/main.py의 MAX_IMAGE_BYTES/MAX_REQUEST_BYTES와 짝을 맞춰 유지할 것.
	handle /api/exam/extract* {
		request_body {
			max_size 5MB
		}

		reverse_proxy localhost:3000 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
		}
	}

	handle {
		request_body {
			max_size 64KB
		}

		# 타임아웃: LLM 생성이 길므로 넉넉히 설정 (frontend → FastAPI 프록시 구간 포함)
		reverse_proxy localhost:3000 {
			transport http {
				read_timeout 300s
				write_timeout 300s
			}
			# SSE 스트리밍을 위한 flush 설정
			flush_interval -1
		}
	}

	# 요청/응답 로그 — PII 포함 가능성이 있으므로 body 로깅 비활성화
	log {
		output file /var/log/caddy/access.log
		format json
		level INFO
	}

	# 보안 헤더
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
