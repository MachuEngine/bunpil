# ── 프론트엔드 → 백엔드 프록시 (frontend/app/api/*/route.ts가 읽음) ─────
BACKEND_URL=http://localhost:8000  # 로컬: FastAPI 직접 접근 주소. docker-compose에선 http://app:8765

# ── LLM 백엔드 ──────────────────────────────────────────────────────
BUNPIL_API_KEY=replace_with_a_long_random_value  # Next.js → FastAPI 서버 간 인증
LLM_BACKEND=local              # local | runpod | openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b       # 생성 전용. 개발 시 1.5b로 교체 가능
OLLAMA_JUDGE_MODEL=qwen2.5:14b  # JUDGE_BACKEND=local일 때만 사용(미설정 시 OLLAMA_MODEL 폴백)
# JUDGE_BACKEND: local(위 OLLAMA_JUDGE_MODEL) | openai(아래 OPENAI_JUDGE_MODEL, 기본) — LLM_BACKEND(생성)와
# 독립적으로 Judge만 교체. 2026-07-21 신뢰도 비교 실험 후 gpt-5.6-luna로 확정(MODEL_SELECTION.md 2절).
# 2026-07-23부터 eval 스크립트뿐 아니라 런타임(app/modules/exam/graph.py judge_node)에도 그대로
# 적용됨 — 생성 모델과 Judge 모델을 완전히 분리하기 위해 자기채점(self-judge)을 폐기하고 별도
# 노드로 분리했기 때문(검증-배포 불일치 해소 목적). openai인데 OPENAI_API_KEY가 없거나 호출이
# 실패하면 조용히 폴백하지 않고 그대로 에러로 실패한다(fail-fast) — 신뢰도가 검증 안 된 채로
# 게이트를 통과시키는 문제를 막기 위함.
JUDGE_BACKEND=openai

# RunPod 서버리스 (Phase 8) — 실값은 .env에만, 커밋 금지
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_ENDPOINT_ID=your_endpoint_id

# OpenAI (LLM_BACKEND=openai 또는 JUDGE_BACKEND=openai일 때 사용) — 실값은 .env에만, 커밋 금지
# JUDGE_BACKEND=openai(기본값)에서는 이 키가 프로덕션 앱 실행에도 필수임(런타임 judge_node가
# 매 문항 세트 생성마다 호출) — 로컬 전용으로 테스트하려면 JUDGE_BACKEND=local로 바꿀 것.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini        # 생성 모델 비교 실험 전용 (LLM_BACKEND=openai일 때만)
OPENAI_JUDGE_MODEL=gpt-5.6-luna  # Judge 기본값(JUDGE_BACKEND=openai, 미설정 시 OPENAI_MODEL 폴백). 채택 근거: experiments/compare_judge_models.py, MODEL_SELECTION.md 2절

# ── 이미지 → 텍스트 추출 (2026-08-19, /exam/extract) ─────────────────────
# 예시 문제 캡처를 붙여넣으면 VLM이 텍스트로 옮긴다. 생성(LLM_BACKEND)·Judge(JUDGE_BACKEND)와
# 완전히 독립된 세 번째 축 — 그래프 밖(app/main.py)에서만 호출되고 LangSmith 트레이싱
# 대상도 아니다. 현재 openai만 지원(local/runpod VLM 경로는 요청받은 적 없어 미구현).
VLM_BACKEND=openai
OPENAI_VLM_MODEL=gpt-4o-mini  # 이미지 추출용. OPENAI_API_KEY를 그대로 사용

# ── RAG 설정 (Phase 1) ───────────────────────────────────────────────
CHROMA_PERSIST_DIR=/data/chroma_db   # 로컬 개발 시: ./chroma_db
BGE_EMBED_MODEL=BAAI/bge-m3
BGE_RERANK_MODEL=BAAI/bge-reranker-base
# 하이브리드 검색(BM25 어휘 검색 + dense를 RRF로 융합, 2026-08-03 도입·채택).
# false면 기존 dense 단독 검색으로 되돌아간다. 새 모델·재인덱싱 불필요
# (BGE-M3 토크나이저와 이미 저장된 청크 텍스트만 사용) — 근거는 MODEL_SELECTION.md 5절.
RAG_HYBRID=true

# ── LangSmith 트레이싱 (선택) ────────────────────────────────────────
# 2026-07-24부터: true로 켜면 출제 모듈(agent_node·judge_node)은 프로덕션 API 서버에서도
# 트레이싱된다(PII 마스킹 후, 실존 인물 정보 아니라 하드룰 3 예외 승인됨 — CLAUDE.md 참고).
# 기본값 false(옵트인) 유지 권장 — 켤 경우 LANGCHAIN_API_KEY 필수.
# (생기부 모듈은 2026-08-03 제거됨 — 과거엔 이 값과 무관하게 트레이싱 안 됐음)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
# 미설정 또는 기본값 'bunpil' 유지 시 LLM_BACKEND 기준으로 자동 분기(app/common/llm/
# tracing.py의 init_langsmith_project()): local(Ollama, 순수 로컬 개발)→-dev,
# runpod/openai 등 실제 서빙 백엔드→-prod. 즉 LANGCHAIN_PROJECT=bunpil이면 실제로는
# bunpil-dev 또는 bunpil-prod로 기록됨 — 로컬 개발 노이즈가 프로덕션 통계를 오염시키지
# 않도록 하기 위함. 'bunpil'이 아닌 다른 값을 직접 설정하면 그 값을 그대로 사용(override).
LANGCHAIN_PROJECT=bunpil
