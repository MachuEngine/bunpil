# ── LLM 백엔드 ──────────────────────────────────────────────────────
BUNPIL_API_KEY=replace_with_a_long_random_value  # Next.js → FastAPI 서버 간 인증
LLM_BACKEND=local              # local | runpod | openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b        # 생성 전용. 개발 시 1.5b로 교체 가능
OLLAMA_JUDGE_MODEL=qwen2.5:7b  # Judge 전용 (미설정 시 OLLAMA_MODEL 폴백). 현재 생성 모델과 동일 7B — 14B는 하드웨어 확보 후 테스트 예정
JUDGE_BACKEND=local            # local(기본, 위 OLLAMA_JUDGE_MODEL 사용) | openai — LLM_BACKEND와 독립적으로 Judge만 교체할 때 사용

# RunPod 서버리스 (Phase 8) — 실값은 .env에만, 커밋 금지
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_ENDPOINT_ID=your_endpoint_id

# OpenAI (모델 비교 실험 전용, LLM_BACKEND=openai 또는 JUDGE_BACKEND=openai일 때만 사용) — 실값은 .env에만, 커밋 금지
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini  # Judge 비교 실험 전용 (미설정 시 OPENAI_MODEL 폴백). scripts/compare_judge_models.py 참고

# ── RAG 설정 (Phase 1) ───────────────────────────────────────────────
CHROMA_PERSIST_DIR=/data/chroma_db   # 로컬 개발 시: ./chroma_db
BGE_EMBED_MODEL=BAAI/bge-m3
BGE_RERANK_MODEL=BAAI/bge-reranker-base

# ── LangSmith 트레이싱 (선택) ────────────────────────────────────────
# API 서버는 사용자 입력 비저장 원칙 때문에 이 값과 무관하게 tracing을 끈다.
# 합성 데이터 eval 스크립트를 실행할 때만 셸에서 true로 명시한다.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your_langsmith_api_key
# 미설정 또는 기본값 'bunpil' 유지 시 LLM_BACKEND 기준으로 자동 분기(app/common/llm/
# tracing.py의 init_langsmith_project()): local(Ollama, 순수 로컬 개발)→-dev,
# runpod/openai 등 실제 서빙 백엔드→-prod. 즉 LANGCHAIN_PROJECT=bunpil이면 실제로는
# bunpil-dev 또는 bunpil-prod로 기록됨 — 로컬 개발 노이즈가 프로덕션 통계를 오염시키지
# 않도록 하기 위함. 'bunpil'이 아닌 다른 값을 직접 설정하면 그 값을 그대로 사용(override).
LANGCHAIN_PROJECT=bunpil
